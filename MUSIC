local function setPlayVisual(isPlaying)
    local isImg = btnPlay:GetAttribute("IsImage")
    local img = btnPlay:FindFirstChild("IconImg")
    local txt = btnPlay:FindFirstChild("IconTxt")

    if isPlaying then
        if isImg and img then
            local pauseAsset = getIcon("si:pause-presentation-duotone", "")
            if pauseAsset and pauseAsset ~= "" then img.Image = pauseAsset end
        elseif txt then txt.Text = "⏸" end
        btnPlay:SetAttribute("AccentColor", C_WARN)
        btnPlay:SetAttribute("ActiveColor", C_WARN)
        btnPlay.BackgroundColor3 = C_WARN
        TweenService:Create(btnPlay, TweenInfo.new(0.2), {BackgroundTransparency = 0.35}):Play()
        if img then img.ImageColor3 = Color3.new(1,1,1) end
        if txt then txt.TextColor3 = Color3.new(1,1,1) end
    else
        if isImg and img then
            local playAsset = getIcon("si:play-fill", "")
            if playAsset and playAsset ~= "" then img.Image = playAsset end
        elseif txt then txt.Text = "▶" end
        btnPlay:SetAttribute("AccentColor", C_OK)
        btnPlay:SetAttribute("ActiveColor", C_OK)
        btnPlay.BackgroundColor3 = C_OK
        TweenService:Create(btnPlay, TweenInfo.new(0.2), {BackgroundTransparency = 0.7}):Play()
        if img then img.ImageColor3 = C_OK end
        if txt then txt.TextColor3 = C_OK end
    end
end

local function setLoopVisual() setIconBtnState(btnLoop, S.loopOn) end
local function setRandVisual() setIconBtnState(btnRand, S.randomOn) end

local function buildShuffleQueue(startIndex)
    shuffledQueue = {}
    for i = 1, #SONGS do
        if i ~= startIndex then table.insert(shuffledQueue, i) end
    end
    for i = #shuffledQueue, 2, -1 do
        local j = math.random(1, i)
        shuffledQueue[i], shuffledQueue[j] = shuffledQueue[j], shuffledQueue[i]
    end
end

local function popShuffle()
    if #shuffledQueue == 0 then buildShuffleQueue(S.index) end
    return table.remove(shuffledQueue, 1)
end

local function playCurrent()
    Music:Stop()
    Music.SoundId = SONGS[S.index].id
    Music.Volume = S.volume
    Music.Looped = S.loopOn
    Music:Play()
    S.playing = true
    setPlayVisual(true)
end

local function stopPlay()
    Music:Stop()
    S.playing = false
    setPlayVisual(false)
    progFill.Size = UDim2.new(0, 0, 1, 0)
end

local function nextSong(auto)
    if S.randomOn then
        S.index = popShuffle()
    else
        S.index = S.index + 1
        if S.index > #SONGS then S.index = 1 end
    end
    updateSong()
    if S.playing or auto then playCurrent() end
end

local function prevSong()
    S.index = S.index - 1
    if S.index < 1 then S.index = #SONGS end
    updateSong()
    if S.playing then playCurrent() end
end

local function togglePlay()
    if S.playing then
        Music:Pause()
        S.playing = false
        setPlayVisual(false)
    else
        if Music.TimePosition > 0 and Music.SoundId == SONGS[S.index].id then
            Music:Resume()
            S.playing = true
            setPlayVisual(true)
        else
            playCurrent()
        end
    end
end

