RunService.Heartbeat:Connect(function()
    local t = tick()
    if Music.IsPlaying then
        local pulse = (math.sin(t * 4) + 1) * 0.5
        stroke1.Transparency = 0.35 - pulse * 0.25
        ballGlow.Transparency = 0.15 - pulse * 0.1
        ballGlowGrad.Rotation = (ballGlowGrad.Rotation + 2) % 360
        togStrokeGrad.Rotation = (togStrokeGrad.Rotation + 1.5) % 360
        hDot.BackgroundColor3 = C_ACC2:Lerp(C_ACC1, pulse)
        hDotGlow.Color = hDot.BackgroundColor3
    else
        stroke1.Transparency = 0.15
        ballGlow.Transparency = 0.2
    end
    stroke1Grad.Rotation = (stroke1Grad.Rotation + 0.5) % 360
end)

task.spawn(function()
    while task.wait(0.1) do
        if Music.IsPlaying and Music.TimeLength > 0 then
            local pct = math.clamp(Music.TimePosition / Music.TimeLength, 0, 1)
            progFill.Size = UDim2.new(pct, 0, 1, 0)
        end
    end
end)

local function setVol(rel)
    rel = math.clamp(rel, 0, 1)
    S.volume = rel
    Music.Volume = rel
    volFill.Size = UDim2.new(rel, 0, 1, 0)
    volKnob.Position = UDim2.new(rel, -4, 0.5, -4)
    volKnobGlow.Position = UDim2.new(rel, -6, 0.5, -6)
end

