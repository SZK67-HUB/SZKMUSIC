local function makeIconBtn(parent, size, pos, iconName, emoji, accent)
    local b = Instance.new("TextButton", parent)
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = accent
    b.BackgroundTransparency = 0.7
    b.Text = ""
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.TextColor3 = accent
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = 6
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local st = Instance.new("UIStroke", b)
    st.Color = accent
    st.Thickness = 1
    st.Transparency = 0.35

    local asset, isImg = getIcon(iconName, emoji)
    if isImg then
        local img = Instance.new("ImageLabel", b)
        img.Name = "IconImg"
        img.Size = UDim2.fromScale(0.6, 0.6)
        img.Position = UDim2.fromScale(0.2, 0.2)
        img.BackgroundTransparency = 1
        img.Image = asset
        img.ImageColor3 = accent
        img.ZIndex = 7
    else
        local lbl = Instance.new("TextLabel", b)
        lbl.Name = "IconTxt"
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.Text = asset
        lbl.TextColor3 = accent
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 13
        lbl.ZIndex = 7
    end

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundTransparency = 0.45}):Play()
        local img = b:FindFirstChild("IconImg")
        if img then TweenService:Create(img, TweenInfo.new(0.12), {ImageColor3 = Color3.new(1,1,1)}):Play() end
        local txt = b:FindFirstChild("IconTxt")
        if txt then TweenService:Create(txt, TweenInfo.new(0.12), {TextColor3 = Color3.new(1,1,1)}):Play() end
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundTransparency = 0.7}):Play()
        local img = b:FindFirstChild("IconImg")
        if img then TweenService:Create(img, TweenInfo.new(0.12), {ImageColor3 = b:GetAttribute("ActiveColor") or accent}):Play() end
        local txt = b:FindFirstChild("IconTxt")
        if txt then TweenService:Create(txt, TweenInfo.new(0.12), {TextColor3 = b:GetAttribute("ActiveColor") or accent}):Play() end
    end)
    b:SetAttribute("ActiveColor", accent)
    b:SetAttribute("AccentColor", accent)
    b:SetAttribute("Stroke", st)
    b:SetAttribute("IsImage", isImg)
    return b
end

local function setIconBtnState(b, on)
    local accent = b:GetAttribute("AccentColor")
    local st = b:GetAttribute("Stroke")
    if on then
        TweenService:Create(b, TweenInfo.new(0.2), {BackgroundTransparency = 0.35, BackgroundColor3 = accent}):Play()
        if st then TweenService:Create(st, TweenInfo.new(0.2), {Transparency = 0.05, Thickness = 1.4}):Play() end
        local img = b:FindFirstChild("IconImg")
        if img then TweenService:Create(img, TweenInfo.new(0.2), {ImageColor3 = Color3.new(1,1,1)}):Play() end
        local txt = b:FindFirstChild("IconTxt")
        if txt then TweenService:Create(txt, TweenInfo.new(0.2), {TextColor3 = Color3.new(1,1,1)}):Play() end
    else
        TweenService:Create(b, TweenInfo.new(0.2), {BackgroundTransparency = 0.7, BackgroundColor3 = accent}):Play()
        if st then TweenService:Create(st, TweenInfo.new(0.2), {Transparency = 0.35, Thickness = 1}):Play() end
        local img = b:FindFirstChild("IconImg")
        if img then TweenService:Create(img, TweenInfo.new(0.2), {ImageColor3 = accent}):Play() end
        local txt = b:FindFirstChild("IconTxt")
        if txt then TweenService:Create(txt, TweenInfo.new(0.2), {TextColor3 = accent}):Play() end
    end
end

