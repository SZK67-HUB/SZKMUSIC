RunService.RenderStepped:Connect(function()
    if dragState.main.dragging then
        local st = dragState.main
        local cur = UserInputService:GetMouseLocation()
        local delta = cur - st.startMouse
        frame.Position = UDim2.new(
            st.startPos.X.Scale, st.startPos.X.Offset + delta.X,
            st.startPos.Y.Scale, st.startPos.Y.Offset + delta.Y
        )
        for i, s in ipairs(shadows) do
            s.Position = UDim2.new(
                frame.Position.X.Scale, frame.Position.X.Offset - i,
                frame.Position.Y.Scale, frame.Position.Y.Offset - i + 2
            )
        end
    end

    if dragState.toggle.dragging then
        local st = dragState.toggle
        local cur = UserInputService:GetMouseLocation()
        local delta = cur - st.startMouse
        toggleBtn.Position = UDim2.new(
            st.startPos.X.Scale, st.startPos.X.Offset + delta.X,
            st.startPos.Y.Scale, st.startPos.Y.Offset + delta.Y
        )
        for i, s in ipairs(toggleShadows) do
            s.Position = UDim2.new(
                toggleBtn.Position.X.Scale, toggleBtn.Position.X.Offset - i,
                toggleBtn.Position.Y.Scale, toggleBtn.Position.Y.Offset - i + 2
            )
        end
    end
end)

