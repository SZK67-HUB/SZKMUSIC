local SolarIcons
pcall(function()
    SolarIcons = (getgenv and (getgenv().SolarIcons or getgenv().solarIcons))
    if not SolarIcons then
        local ok, src = pcall(game.HttpGet, game,
            "https://raw.githubusercontent.com/1stNox/SolarIcons/main/SolarIcons.lua", true)
        if ok and src and #src > 100 then
            local fn = loadstring(src)
            if fn then SolarIcons = fn() end
        end
    end
end)

local function getIcon(name, emoji)
    if SolarIcons then
        local ok, asset = pcall(SolarIcons, name)
        if ok and type(asset) == "string" and asset ~= "" then
            return asset, true
        end
    end
    return emoji, false
end

