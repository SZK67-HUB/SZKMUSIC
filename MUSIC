local dragState = {
    main   = {dragging=false, startMouse=nil, startPos=nil},
    toggle = {dragging=false, startMouse=nil, startPos=nil},
}

local function beginDrag(key, pos)
    dragState[key].dragging = true
    dragState[key].startMouse = UserInputService:GetMouseLocation()
    dragState[key].startPos = pos
end

local function endDrag(key) dragState[key].dragging = false end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
